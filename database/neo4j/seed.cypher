// Run in Neo4j Browser after starting the instance. IDs mirror PostgreSQL components.id values.
MERGE (web:Component {id: 1, name: 'web-portal', kind: 'frontend'})
MERGE (api:Component {id: 2, name: 'api-gateway', kind: 'service'})
MERGE (identity:Component {id: 3, name: 'identity-service', kind: 'service'})
MERGE (catalog:Component {id: 4, name: 'catalog-service', kind: 'service'})
MERGE (orders:Component {id: 5, name: 'order-service', kind: 'service'})
MERGE (payment:Component {id: 6, name: 'payment-service', kind: 'service'})
MERGE (inventory:Component {id: 7, name: 'inventory-service', kind: 'service'})
MERGE (notify:Component {id: 8, name: 'notification-worker', kind: 'worker'})
MERGE (postgres:Component {id: 9, name: 'postgres-db', kind: 'database'})
MERGE (redis:Component {id: 10, name: 'redis-cache', kind: 'database'})
MERGE (web)-[:DEPENDS_ON]->(api)
MERGE (api)-[:DEPENDS_ON]->(identity)
MERGE (api)-[:DEPENDS_ON]->(catalog)
MERGE (api)-[:DEPENDS_ON]->(orders)
MERGE (catalog)-[:DEPENDS_ON]->(postgres)
MERGE (catalog)-[:DEPENDS_ON]->(redis)
MERGE (orders)-[:DEPENDS_ON]->(payment)
MERGE (orders)-[:DEPENDS_ON]->(inventory)
MERGE (orders)-[:DEPENDS_ON]->(postgres)
MERGE (payment)-[:DEPENDS_ON]->(notify)
MERGE (inventory)-[:DEPENDS_ON]->(notify)
MERGE (inventory)-[:DEPENDS_ON]->(postgres);
